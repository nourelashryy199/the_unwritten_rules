
# ============================================================
# THE UNWRITTEN RULES — .gitignore
# ============================================================

# ------------------------------------------------------------
# Python: bytecode and compiled files
# ------------------------------------------------------------

__pycache__/
*.py[codz]
*$py.class
*.so

# ------------------------------------------------------------
# Python: packaging and distribution
# ------------------------------------------------------------

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------
# Python: PyInstaller
# ------------------------------------------------------------

*.manifest
*.spec

# ------------------------------------------------------------
# Python: installer logs
# ------------------------------------------------------------

pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------
# Python: virtual environments
# ------------------------------------------------------------

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------
# Python: testing and coverage
# ------------------------------------------------------------

htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/

# ------------------------------------------------------------
# Python: type checking, linting, and formatting
# ------------------------------------------------------------

.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------
# Python: development tools
# ------------------------------------------------------------

.pybuilder/
target/
.ipynb_checkpoints/
profile_default/
ipython_config.py
__pypackages__/
.pdm-python
.pdm-build/
.pixi/*
!.pixi/config.toml

# ------------------------------------------------------------
# Python: generated framework files
# ------------------------------------------------------------

*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache/
.scrapy/
docs/_build/
site/
cython_debug/

# ------------------------------------------------------------
# Python: background services
# ------------------------------------------------------------

celerybeat-schedule*
celerybeat.pid
*.rdb
*.aof
*.pid
mnesia/
rabbitmq/
rabbitmq-data/
activemq-data/

# ------------------------------------------------------------
# Environment variables and secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

.envrc

*.pem
*.key
*.p12
*.pfx

.pypirc
.streamlit/secrets.toml

# ------------------------------------------------------------
# Frontend: Node.js / React / TypeScript
# ------------------------------------------------------------

node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*.tsbuildinfo

# Frontend build outputs
frontend/dist/
frontend/build/
frontend/coverage/

# Local frontend environment files are covered by
# the global .env and .env.* patterns above.

# ------------------------------------------------------------
# IDEs and editors
# ------------------------------------------------------------

.vscode/
.idea/

*.swp
*.swo
*~

tempCodeRunnerFile.py

.spyderproject
.spyproject
.ropeproject

# ------------------------------------------------------------
# macOS
# ------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride

._*

.Spotlight-V100
.Trashes

# ------------------------------------------------------------
# Windows
# ------------------------------------------------------------

Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Docker and local infrastructure
# ------------------------------------------------------------

docker-compose.override.yml
compose.override.yml

# Local database volumes
postgres_data/
pgdata/

# Local service data
redis_data/

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.orig

# ------------------------------------------------------------
# Generated datasets and model artifacts
# ------------------------------------------------------------

# Ignore downloaded or generated datasets.
# Keep small, curated evaluation fixtures in Git.

data/raw/
data/processed/

# Ignore generated model checkpoints and artifacts.
models/checkpoints/
models/artifacts/

# ------------------------------------------------------------
# Documentation and source code
# ------------------------------------------------------------

# Documentation, source code, tests, configuration templates,
# and architectural decision records should remain tracked.

# Examples of files that SHOULD be committed:
#
# docs/architecture.md
# docs/engineering_standards.md
# docs/experience_schema.md
# backend/pyproject.toml
# backend/src/
# backend/tests/
# .env.example
# Dockerfile
# compose.yml
# .github/workflows/
